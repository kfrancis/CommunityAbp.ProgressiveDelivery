<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>CommunityAbp.ProgressiveDelivery.Sample.Web</RootNamespace>
    <UserSecretsId>0b3a3c05-6c9c-4a2b-8a0b-6f0f8b1d0f21</UserSecretsId>
    <AbpProjectType>app</AbpProjectType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommunityAbp.ProgressiveDelivery.Sample.ServiceDefaults\CommunityAbp.ProgressiveDelivery.Sample.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\src\CommunityAbp.ProgressiveDelivery.Application\CommunityAbp.ProgressiveDelivery.Application.csproj" />
    <ProjectReference Include="..\..\src\CommunityAbp.ProgressiveDelivery.AspNetCore\CommunityAbp.ProgressiveDelivery.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\CommunityAbp.ProgressiveDelivery.EntityFrameworkCore\CommunityAbp.ProgressiveDelivery.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\CommunityAbp.ProgressiveDelivery.HttpApi\CommunityAbp.ProgressiveDelivery.HttpApi.csproj" />
    <ProjectReference Include="..\..\src\CommunityAbp.ProgressiveDelivery.OpenTelemetry\CommunityAbp.ProgressiveDelivery.OpenTelemetry.csproj" />
    <ProjectReference Include="..\..\src\CommunityAbp.ProgressiveDelivery.Web\CommunityAbp.ProgressiveDelivery.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Autofac" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.Basic" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Volo.Abp.Swashbuckle" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <!-- Client-side libraries (jQuery, Bootstrap, DataTables, ABP scripts) come from npm via the ABP CLI.
       Runs once on first build when the CLI and Node are available; CI only needs the build to compile. -->
  <Target Name="AbpInstallLibs" BeforeTargets="Build" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\libs\abp') And '$(GITHUB_ACTIONS)' != 'true' And '$(CI)' != 'true'">
    <Exec Command="abp install-libs" WorkingDirectory="$(MSBuildProjectDirectory)" ContinueOnError="true" />
  </Target>

</Project>
