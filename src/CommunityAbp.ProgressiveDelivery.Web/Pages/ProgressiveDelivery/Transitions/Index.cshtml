@page
@model CommunityAbp.ProgressiveDelivery.Web.Pages.ProgressiveDelivery.Transitions.IndexModel
@{
    PageLayout.Content.Title = L["Transitions"].Value;
    PageLayout.Content.BreadCrumb.Add(L["Menu:ProgressiveDelivery"].Value);
    PageLayout.Content.MenuItemName = ProgressiveDeliveryMenus.Transitions;
}

@section styles {
    <abp-style src="/Pages/ProgressiveDelivery/progressive-delivery.css" />
}

@section scripts {
    <abp-script src="/Pages/ProgressiveDelivery/Transitions/index.js" />
}

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_4">
                <abp-card-title>@L["Transitions"]</abp-card-title>
                <p class="text-muted small mb-0">@L["TransitionsIntro"]</p>
            </abp-column>
            <abp-column size-md="_8">
                <div class="row g-2 justify-content-end">
                    @if (Model.CanFilterByTrack)
                    {
                        <div class="col-md-4"><select id="TrackFilter" class="form-select form-select-sm" asp-items="Model.TrackItems"></select></div>
                    }
                    <div class="col-md-3"><select id="TypeFilter" class="form-select form-select-sm" asp-items="Model.TransitionTypeItems"></select></div>
                    <div class="col-md-2"><input id="SubjectTypeFilter" class="form-control form-control-sm" placeholder="@L["SubjectType"]" /></div>
                    <div class="col-md-3"><input id="SubjectIdFilter" class="form-control form-control-sm" placeholder="@L["SubjectId"]" /></div>
                </div>
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table striped-rows="true" id="TransitionsTable"></abp-table>
    </abp-card-body>
</abp-card>
