@page
@using CommunityAbp.ProgressiveDelivery.Web.Pages.ProgressiveDelivery.Tracks
@model DetailModel
@{
    PageLayout.Content.Title = Model.Track.DisplayName ?? Model.Track.Name;
    PageLayout.Content.BreadCrumb.Add(L["Menu:ProgressiveDelivery"].Value);
    PageLayout.Content.BreadCrumb.Add(L["Tracks"].Value, "/ProgressiveDelivery/Tracks");
    PageLayout.Content.MenuItemName = ProgressiveDeliveryMenus.Tracks;

    var canManageTracks = await AuthorizationService.IsGrantedAsync(ProgressiveDeliveryPermissions.Tracks.Manage);
    var canManageLevels = await AuthorizationService.IsGrantedAsync(ProgressiveDeliveryPermissions.Levels.Manage);
    var canViewRollouts = await AuthorizationService.IsGrantedAsync(ProgressiveDeliveryPermissions.Rollouts.Default);
    var canManageRollouts = await AuthorizationService.IsGrantedAsync(ProgressiveDeliveryPermissions.Rollouts.Manage);
    var canViewAssignments = await AuthorizationService.IsGrantedAsync(ProgressiveDeliveryPermissions.Assignments.View);
    var canOverride = await AuthorizationService.IsGrantedAsync(ProgressiveDeliveryPermissions.Assignments.Override);
    var canViewHistory = await AuthorizationService.IsGrantedAsync(ProgressiveDeliveryPermissions.Telemetry);
    var track = Model.Track;
}

@section styles {
    <abp-style src="/Pages/ProgressiveDelivery/progressive-delivery.css" />
}

@section scripts {
    <abp-script src="/Pages/ProgressiveDelivery/Tracks/detail.js" />
}

<div id="TrackDetail"
     data-track-id="@track.Id"
     data-track-name="@track.Name"
     data-official-level="@track.OfficialLevel"
     data-highest-level="@track.HighestAvailableLevel"
     data-is-enabled="@track.IsEnabled.ToString().ToLowerInvariant()"
     data-concurrency-stamp="@track.ConcurrencyStamp"
     data-display-name="@track.DisplayName"
     data-description="@track.Description">

    <abp-card class="mb-3">
        <abp-card-header>
            <abp-row>
                <abp-column size-md="_8">
                    <abp-card-title>
                        <span class="pd-mono">@track.Name</span>
                        @if (track.IsEnabled)
                        {
                            <span class="badge bg-success-subtle text-success ms-2">@L["Enabled"]</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary ms-2">@L["Disabled"]</span>
                        }
                    </abp-card-title>
                    @if (!string.IsNullOrWhiteSpace(track.Description))
                    {
                        <p class="text-muted small mb-0">@track.Description</p>
                    }
                </abp-column>
                <abp-column size-md="_4" class="text-end">
                    @if (canManageTracks)
                    {
                        <abp-button id="EditTrackButton" text="@L["EditTrack"].Value" icon="pen" button-type="Outline_Secondary" size="Small" />
                        <abp-button id="PromoteButton" text="@L["SetOfficialLevel"].Value" icon="arrow-up" button-type="Primary" size="Small" />
                    }
                </abp-column>
            </abp-row>
        </abp-card-header>
        <abp-card-body>
            <partial name="~/Pages/ProgressiveDelivery/Shared/_LevelLine.cshtml" model="Model.LevelLine" />
            <div class="text-muted small mt-2">
                @L["LevelLineLegend"]
            </div>
        </abp-card-body>
    </abp-card>

    <abp-card>
        <abp-card-body>
            <abp-tabs name="TrackTabs">
                <abp-tab name="levels" title="@L["Levels"].Value" active="true">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <p class="text-muted small mb-0">@L["LevelsIntro"]</p>
                        @if (canManageLevels)
                        {
                            <abp-button id="AddLevelButton" text="@L["AddLevel"].Value" icon="plus" button-type="Outline_Primary" size="Small" />
                        }
                    </div>
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th style="width: 70px">@L["Level"]</th>
                                <th>@L["Description"]</th>
                                <th>@L["SupportDescription"]</th>
                                <th>@L["FallbackPolicy"]</th>
                                <th>@L["IsPerformanceSensitive"]</th>
                                <th style="width: 200px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var level in track.Levels.OrderBy(l => l.Level))
                            {
                                var tone = level.Level == track.OfficialLevel ? "official" : level.Level > track.OfficialLevel ? "experimental" : "muted";
                                <tr>
                                    <td><span class="pd-pill pd-pill-@tone">@level.Level</span></td>
                                    <td>@level.Description</td>
                                    <td class="text-muted small">@level.SupportDescription</td>
                                    <td><span class="pd-policy pd-policy-@level.FallbackPolicy" title="@L["Policy:" + level.FallbackPolicy]">@level.FallbackPolicy</span></td>
                                    <td>
                                        @if (level.IsPerformanceSensitive)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis">@L["PerformanceSensitive"]</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (canManageLevels)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary pd-edit-level" data-level="@level.Level"><i class="fa fa-pen"></i> @L["Edit"]</button>
                                        }
                                        @if (canManageTracks && level.Level != track.OfficialLevel)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary pd-promote-level" data-level="@level.Level">@L["MakeOfficial"]</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </abp-tab>

                @if (canViewRollouts)
                {
                    <abp-tab name="rollouts" title="@L["Rollouts"].Value">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <p class="text-muted small mb-0">@L["RolloutsIntro"]</p>
                            @if (canManageRollouts && track.HighestAvailableLevel > track.OfficialLevel)
                            {
                                <abp-button id="NewRolloutButton" text="@L["NewRollout"].Value" icon="plus" button-type="Outline_Primary" size="Small" />
                            }
                        </div>
                        @if (!track.Rollouts.Any())
                        {
                            <div class="text-muted">@L["NoRollouts"]</div>
                        }
                        <abp-row>
                            @foreach (var rollout in track.Rollouts.OrderBy(r => r.TargetLevel))
                            {
                                <abp-column size-md="_4" class="mb-3">
                                    <div class="pd-rollout-card" data-target-level="@rollout.TargetLevel">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <div class="text-muted small">@L["TargetLevel"]</div>
                                                <div><span class="pd-pill pd-pill-experimental">@rollout.TargetLevel</span></div>
                                            </div>
                                            <span class="badge bg-secondary-subtle text-secondary">@L["Enum:FeatureRolloutStatus." + rollout.Status]</span>
                                        </div>
                                        <div class="pd-rollout-pct mt-2">@DetailModel.FormatPercentage(rollout.PercentageBasisPoints)</div>
                                        @if (rollout.AllowSkippingIntermediateLevels)
                                        {
                                            <div class="small text-warning-emphasis">@L["AllowSkippingIntermediateLevels"]</div>
                                        }
                                        @if (canManageRollouts)
                                        {
                                            <div class="mt-3 d-flex flex-wrap gap-1">
                                                <button type="button" class="btn btn-sm btn-outline-secondary pd-rollout-edit" data-level="@rollout.TargetLevel">@L["Edit"]</button>
                                                @if (rollout.Status == FeatureRolloutStatus.Active)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-secondary pd-rollout-status" data-level="@rollout.TargetLevel" data-status="@((int)FeatureRolloutStatus.Paused)">@L["Pause"]</button>
                                                }
                                                else if (rollout.Status is FeatureRolloutStatus.Paused or FeatureRolloutStatus.Suspended)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-secondary pd-rollout-status" data-level="@rollout.TargetLevel" data-status="@((int)FeatureRolloutStatus.Active)">@L["Resume"]</button>
                                                }
                                                @if (rollout.Status != FeatureRolloutStatus.Suspended && rollout.Status != FeatureRolloutStatus.Completed)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-warning pd-rollout-suspend" data-level="@rollout.TargetLevel">@L["Suspend"]</button>
                                                }
                                                <button type="button" class="btn btn-sm btn-outline-danger pd-rollout-remove" data-level="@rollout.TargetLevel">@L["Remove"]</button>
                                            </div>
                                        }
                                    </div>
                                </abp-column>
                            }
                        </abp-row>
                    </abp-tab>
                }

                @if (canViewAssignments)
                {
                    <abp-tab name="assignments" title="@L["Assignments"].Value">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <p class="text-muted small mb-0">@L["AssignmentsIntro"]</p>
                            @if (canOverride)
                            {
                                <abp-button id="OverrideButton" text="@L["OverrideAssignment"].Value" icon="user-edit" button-type="Outline_Primary" size="Small" />
                            }
                        </div>
                        <abp-table striped-rows="true" id="AssignmentsTable"></abp-table>
                    </abp-tab>
                }

                @if (canViewHistory)
                {
                    <abp-tab name="history" title="@L["History"].Value">
                        <abp-table striped-rows="true" id="HistoryTable"></abp-table>
                    </abp-tab>
                }

                @if (canManageTracks)
                {
                    <abp-tab name="danger" title="@L["DangerZone"].Value">
                        <div class="pd-danger-zone">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <strong>@(track.IsEnabled ? L["DisableTrack"] : L["EnableTrack"])</strong>
                                    <div class="text-muted small">@L["DisableTrackHelp"]</div>
                                </div>
                                <button type="button" id="ToggleEnabledButton" class="btn btn-outline-warning btn-sm">@(track.IsEnabled ? L["DisableTrack"] : L["EnableTrack"])</button>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@L["DeleteTrack"]</strong>
                                    <div class="text-muted small">@L["DeleteTrackHelp"]</div>
                                </div>
                                <button type="button" id="DeleteTrackButton" class="btn btn-outline-danger btn-sm">@L["DeleteTrack"]</button>
                            </div>
                        </div>
                    </abp-tab>
                }
            </abp-tabs>
        </abp-card-body>
    </abp-card>
</div>
