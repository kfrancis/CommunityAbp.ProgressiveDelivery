@page
@model CommunityAbp.ProgressiveDelivery.Web.Pages.ProgressiveDelivery.Tracks.EditModalModel
@{
    Layout = null;
}
<abp-dynamic-form abp-model="Track" asp-page="/ProgressiveDelivery/Tracks/EditModal">
    <abp-modal>
        <abp-modal-header title="@L["EditTrack"].Value"></abp-modal-header>
        <abp-modal-body>
            <div class="mb-3"><span class="pd-mono fw-semibold">@Model.TrackName</span></div>
            <abp-form-content />
            <p class="text-muted small mb-0">@L["DisableTrackHelp"]</p>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</abp-dynamic-form>
