@page
@model CommunityAbp.ProgressiveDelivery.Web.Pages.ProgressiveDelivery.Rollouts.EditModalModel
@{
    Layout = null;
}
<form method="post" asp-page="/ProgressiveDelivery/Rollouts/EditModal">
    <abp-modal>
        <abp-modal-header title="@L["EditRolloutN", Model.Input.TargetLevel].Value"></abp-modal-header>
        <abp-modal-body>
            <div class="mb-2"><span class="pd-mono fw-semibold">@Model.TrackName</span></div>
            <abp-input asp-for="Input.TrackId" />
            <abp-input asp-for="Input.TargetLevel" />
            <abp-input asp-for="Input.Percentage" label="@L["Percentage"].Value" info="@L["PercentageHelp"].Value" />
            <abp-select asp-for="Input.Status" asp-items="Model.StatusItems" label="@L["Status"].Value" />
            <abp-input asp-for="Input.AllowSkippingIntermediateLevels" label="@L["AllowSkippingIntermediateLevels"].Value" />
            <div class="alert alert-light border small mb-0">@L["ShrinkRolloutHelp"]</div>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
